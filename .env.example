# Copy to .env (`composer setup` does it). .env is git-ignored and holds only the private keys: every other setting
# has its default in config/ (SurveyJS settings in config/surveyjs.php, Laravel's in config/app.php and the rest),
# which is committed. Variables set in the environment win over .env; both win over the defaults in config/.

# Laravel's encryption key: `composer setup` (php artisan key:generate) fills it in
APP_KEY=

# Commercial examples (Dashboard, Creator) run without a key and show a licence banner. Set, the pages call
# setLicenseKey(). The SurveyJS service at its pinned revision ignores it, so server PDFs keep the alert banner.
SURVEYJS_LICENSE_KEY=

# Extract Responses from Documents: the SurveyJS service's key. With a key and no provider set, the service uses
# that key's provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Translate with AI: the key for the endpoint in config/surveyjs.php (ai.base_url). Without it, /api/translate
# answers 501.
AI_API_KEY=

# docker compose only: it can't read config/surveyjs.php, so to pick the service's provider or model, or to use
# Ollama, set these here (or in your shell) as well as in config/surveyjs.php
# SURVEYJS_AI_PROVIDER=ollama
# SURVEYJS_AI_MODEL=
# SURVEYJS_OLLAMA_BASE_URL=http://host.docker.internal:11434
